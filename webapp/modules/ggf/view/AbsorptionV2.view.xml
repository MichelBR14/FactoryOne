<mvc:View
  controllerName="factoreone.app.modules.ggf.controller.AbsorptionV2"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true"
>
  <Page title="{ggfText>ggfV2Title}" showNavButton="true" navButtonPress=".onBack" navButtonTooltip="{ggfText>ggfV2Back}">
    <content>
      <VBox class="sapUiResponsiveContentPadding">
        <MessageStrip text="{ggfText>ggfV2Technical}" type="Warning" showIcon="true" class="sapUiSmallMarginBottom" />
        <MessageStrip text="{ggfText>ggfV2NeedSapRead}" type="Information" showIcon="true" visible="{= !${v2>/sapRead} }" class="sapUiSmallMarginBottom" />
        <Title text="{ggfText>ggfV2Period}" level="H2" titleStyle="H4" />
        <HBox wrap="Wrap" alignItems="End" class="sapUiSmallMarginBottom">
          <VBox class="sapUiSmallMarginEnd sapUiSmallMarginTop"><Label text="{ggfText>ggfV2Start}"/><DatePicker value="{v2>/start}" valueFormat="yyyy-MM-dd" displayFormat="medium" width="12rem"/></VBox>
          <VBox class="sapUiSmallMarginEnd sapUiSmallMarginTop"><Label text="{ggfText>ggfV2End}"/><DatePicker value="{v2>/end}" valueFormat="yyyy-MM-dd" displayFormat="medium" width="12rem"/></VBox>
          <VBox class="sapUiSmallMarginEnd sapUiSmallMarginTop"><Label text="{ggfText>ggfV2Branch}"/><Input value="{v2>/branch}" width="10rem"/></VBox>
          <VBox class="sapUiSmallMarginEnd sapUiSmallMarginTop"><Label text="{ggfText>ggfV2Dimensions}"/><HBox><Input value="{v2>/dimensions/0}" width="4rem"/><Input value="{v2>/dimensions/1}" width="4rem"/><Input value="{v2>/dimensions/2}" width="4rem"/><Input value="{v2>/dimensions/3}" width="4rem"/><Input value="{v2>/dimensions/4}" width="4rem"/></HBox></VBox>
          <Button text="{ggfText>ggfV2Run}" type="Emphasized" icon="sap-icon://refresh" press=".onRun" busy="{v2>/busy}" enabled="{= ${v2>/sapRead} &amp;&amp; !${v2>/busy} }" class="sapUiSmallMarginTop" />
        </HBox>
        <Title text="{ggfText>ggfV2Mapping}" level="H2" titleStyle="H4" class="sapUiMediumMarginTop" />
        <Text text="{ggfText>ggfV2MappingHint}" class="sapUiTinyMarginBottom" />
        <TextArea value="{v2>/mapping}" rows="8" growing="true" growingMaxLines="14" width="100%" valueLiveUpdate="false" change=".onMappingChange" />
        <Title text="Parametrização contábil local" level="H2" titleStyle="H4" class="sapUiMediumMarginTop" />
        <MessageStrip text="Contas não são inferidas por descrição. Informe códigos autorizados pelo cliente; esta configuração fica somente neste navegador e não é gravada no SAP." type="Information" showIcon="true" />
        <TextArea value="{v2>/accountingConfig}" rows="8" growing="true" growingMaxLines="14" width="100%" valueLiveUpdate="false" change=".onAccountingConfigChange" />
        <Title text="Distribuição do valor ainda não absorvido" level="H2" titleStyle="H4" class="sapUiMediumMarginTop" />
        <MessageStrip text="MOD e GGF são calculados separadamente. Esta simulação técnica não é uma regra funcional aprovada e não contabiliza no SAP." type="Warning" showIcon="true" class="sapUiTinyMarginBottom" />
        <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
          <VBox class="sapUiSmallMarginEnd sapUiSmallMarginTop">
            <Title text="MOD" level="H3" titleStyle="H5" />
            <Label text="Critério de rateio"/><Select selectedKey="{v2>/modCriterion}" width="18rem"><items>
              <core:Item key="DIRECT_COST" text="Absorção por Custo Direto"/><core:Item key="QUANTITY" text="Quantidade Produzida"/><core:Item key="HOURS" text="Horas Apontadas"/><core:Item key="RESOURCE_GROUP" text="Distribuição por Grupo de Recurso"/>
            </items></Select>
            <Label text="OPs elegíveis (separadas por vírgula)" class="sapUiTinyMarginTop"/><Input value="{v2>/modOrders}" width="18rem"/>
            <Label text="Percentuais dos grupos MOD (JSON; soma 100%)" class="sapUiTinyMarginTop"/><TextArea value="{v2>/modGroupShares}" rows="3" growing="true" width="100%" placeholder='[{"group":"&lt;código SAP&gt;","percent":"20","basis":"RESOURCE_VALUE"}]'/>
          </VBox>
          <VBox class="sapUiSmallMarginEnd sapUiSmallMarginTop">
            <Title text="GGF" level="H3" titleStyle="H5" />
            <Label text="Critério de rateio"/><Select selectedKey="{v2>/ggfCriterion}" width="18rem"><items>
              <core:Item key="DIRECT_COST" text="Absorção por Custo Direto"/><core:Item key="QUANTITY" text="Quantidade Produzida"/><core:Item key="HOURS" text="Horas Apontadas"/><core:Item key="RESOURCE_GROUP" text="Distribuição por Grupo de Recurso"/>
            </items></Select>
            <Label text="OPs elegíveis (separadas por vírgula)" class="sapUiTinyMarginTop"/><Input value="{v2>/ggfOrders}" width="18rem"/>
            <Label text="Percentuais dos grupos GGF (JSON; soma 100%)" class="sapUiTinyMarginTop"/><TextArea value="{v2>/ggfGroupShares}" rows="3" growing="true" width="100%" placeholder='[{"group":"&lt;código SAP&gt;","percent":"20","basis":"RESOURCE_VALUE"}]'/>
          </VBox>
        </HBox>
        <MessageStrip text="{ggfText>ggfV2NoData}" type="Information" showIcon="true" visible="{= !${v2>/hasResult} }" class="sapUiMediumMarginTop" />
        <VBox visible="{v2>/hasResult}" class="sapUiMediumMarginTop">
          <Title text="{ggfText>ggfV2Real} / {ggfText>ggfV2Absorbed} / {ggfText>ggfV2Difference}" level="H2" titleStyle="H4" />
          <MessageStrip text="{= ${v2>/report/technicalHomologation} ? 'Homologação técnica. Não representa regra funcional aprovada.' : '' }" type="Warning" showIcon="true" />
          <FlexBox items="{v2>/statuses}" wrap="Wrap" class="sapUiTinyMarginTop sapUiTinyMarginBottom"><ObjectStatus text="{v2>text}" state="Warning" class="sapUiTinyMarginEnd"/></FlexBox>
          <List items="{v2>/summary}" showSeparators="Inner">
            <CustomListItem>
              <HBox justifyContent="SpaceBetween" wrap="Wrap" class="sapUiSmallMargin">
                <ObjectIdentifier title="{v2>category}" text="{v2>statusText}" />
                <ObjectStatus title="{ggfText>ggfV2Real}" text="{v2>real}" />
                <ObjectStatus title="{ggfText>ggfV2Absorbed}" text="{v2>absorbed}" />
                <ObjectStatus title="{ggfText>ggfV2Difference}" text="{v2>difference}" state="{= ${v2>status} === 'CONCILIATED' ? 'Success' : 'Warning' }" />
              </HBox>
            </CustomListItem>
          </List>
          <Title text="Rateio do saldo por absorver" level="H2" titleStyle="H4" class="sapUiMediumMarginTop" />
          <MessageStrip text="A soma distribuída pode diferir do valor total quando alguma categoria estiver bloqueada. Diferença não distribuída permanece explícita." type="Information" showIcon="true" />
          <Table items="{v2>/distributionCategories}" growing="true">
            <columns><Column><Text text="Categoria"/></Column><Column><Text text="Critério"/></Column><Column><Text text="Status"/></Column><Column hAlign="End"><Text text="A distribuir"/></Column><Column hAlign="End"><Text text="Distribuído"/></Column><Column hAlign="End"><Text text="Diferença"/></Column></columns>
            <items><ColumnListItem><cells><Text text="{v2>category}"/><Text text="{v2>criterion}"/><ObjectStatus text="{v2>statusText}" state="{= ${v2>residualCents} === '0' ? 'Success' : 'Warning' }"/><Text text="{v2>difference}"/><Text text="{v2>allocated}"/><Text text="{v2>residual}"/></cells></ColumnListItem></items>
          </Table>
          <Title text="Distribuição por OP / produto" level="H2" titleStyle="H4" class="sapUiMediumMarginTop" />
          <Table items="{v2>/distributionOrders}" growing="true" growingScrollToLoad="true" minScreenWidth="Tablet" demandPopin="true">
            <columns><Column><Text text="OP / produto"/></Column><Column hAlign="End"><Text text="MOD padrão"/></Column><Column hAlign="End"><Text text="GGF padrão"/></Column><Column hAlign="End"><Text text="MOD ajuste"/></Column><Column hAlign="End"><Text text="GGF ajuste"/></Column><Column hAlign="End"><Text text="Total ajuste"/></Column><Column hAlign="End"><Text text="Custo base técnico"/></Column><Column hAlign="End"><Text text="Após ajuste"/></Column><Column><Text text="Memória e origem"/></Column></columns>
            <items><ColumnListItem><cells><ObjectIdentifier title="OP {v2>orderNumber} · {v2>item}" text="{v2>itemDescription} · {v2>producedQuantity} {v2>quantityUnit}"/><Text text="{v2>standardMod}"/><Text text="{v2>standardGgf}"/><Text text="{v2>mod}"/><Text text="{v2>ggf}"/><ObjectStatus text="{v2>total}"/><Text text="{v2>originalCost}"/><Text text="{v2>costAfter}"/><Text text="{v2>baseText}" wrapping="true"/></cells></ColumnListItem></items>
          </Table>
          <Title text="Conciliação do rateio" level="H3" titleStyle="H5" class="sapUiMediumMarginTop" />
          <HBox wrap="Wrap" justifyContent="SpaceBetween"><ObjectStatus title="Diferença a distribuir" text="{v2>/distributionTotals/difference}"/><ObjectStatus title="Total distribuído" text="{v2>/distributionTotals/allocated}"/><ObjectStatus title="Saldo não distribuído" text="{v2>/distributionTotals/residual}" state="{= ${v2>/distribution/residualCents} === '0' ? 'Success' : 'Warning' }"/></HBox>
          <List items="{v2>/distributionWarnings}" visible="{= ${v2>/distributionWarnings}.length > 0 }"><StandardListItem title="{v2>text}" icon="sap-icon://message-warning"/></List>
          <Title text="5. Estoque x Consumido" level="H2" titleStyle="H4" class="sapUiMediumMarginTop" />
          <MessageStrip text="Valores de estoque e CPV só são candidatos quando o recebimento da OP e todas as movimentações posteriores estão reconciliados. Saídas não são classificadas automaticamente como CPV. Nenhum documento SAP é criado." type="Warning" showIcon="true" />
          <MessageStrip text="O saldo é agregado por item e depósito e pode aparecer repetido quando mais de uma OP produz o mesmo item; não some nem atribua esse saldo às OPs." type="Information" showIcon="true" />
          <Table items="{v2>/stockConsumptionOrders}" growing="true" growingScrollToLoad="true" class="sapUiTinyMarginTop">
            <columns><Column><Text text="OP / item"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Quantidade produzida"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Método / unidade"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Ajuste MOD · estoque / consumido"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Ajuste GGF · estoque / consumido"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Estoque atual"/></Column><Column minScreenWidth="Desktop" demandPopin="true"><Text text="Depósitos lidos"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Status"/></Column><Column minScreenWidth="Desktop" demandPopin="true"><Text text="Motivo / rastreio"/></Column></columns>
            <items><ColumnListItem><cells><ObjectIdentifier title="OP {v2>orderNumber} · {v2>item}"/><Text text="{v2>producedText}"/><Text text="{v2>valuationMethodText} · {v2>unit}"/><Text text="{v2>modAdjustment} · {v2>modStock} / {v2>modConsumed}"/><Text text="{v2>ggfAdjustment} · {v2>ggfStock} / {v2>ggfConsumed}"/><Text text="{v2>stock}"/><Text text="{v2>warehouseText}" wrapping="true"/><ObjectStatus text="{v2>statusText}" state="Warning"/><Text text="{v2>reason}" wrapping="true"/></cells></ColumnListItem></items>
          </Table>
          <MessageStrip text="Os rateios MOD/GGF destas OPs permanecem bloqueados para divisão: o saldo atual por item/depósito não demonstra qual recebimento da OP continua em estoque nem classifica todas as saídas." type="Information" showIcon="true" visible="{= ${v2>/stockConsumptionOrders}.length > 0 }" class="sapUiTinyMarginTop" />
          <Panel headerText="Cenário FIFO técnico independente · OP 83" expandable="true" expanded="false" visible="{= !!${v2>/fifoScenario} }" class="sapUiSmallMarginTop">
            <content><VBox>
              <MessageStrip text="Demonstração técnica controlada, separada da distribuição funcional: ajuste exemplo de R$ 100,00, sem conta GGF. Não representa resultado real de fechamento e não gera Reavaliação ou lançamento." type="Warning" showIcon="true" />
              <HBox wrap="Wrap" class="sapUiSmallMarginTop"><ObjectIdentifier title="Status" text="{v2>/fifoScenario/splitStatusText}" class="sapUiSmallMarginEnd"/><ObjectIdentifier title="Método" text="{v2>/fifoScenario/methodText}" class="sapUiSmallMarginEnd"/><ObjectIdentifier title="Produzido" text="{v2>/fifoScenario/producedText}" class="sapUiSmallMarginEnd"/><ObjectIdentifier title="Consumido" text="{v2>/fifoScenario/consumedText}" class="sapUiSmallMarginEnd"/><ObjectIdentifier title="Saldo rastreado" text="{v2>/fifoScenario/remainingText}"/></HBox>
              <Text text="Recebimento: {v2>/fifoScenario/receiptText}" wrapping="true" class="sapUiTinyMarginTop"/><Text text="Saída reconciliada: {v2>/fifoScenario/outflowText}" wrapping="true" class="sapUiTinyMarginTop"/><Text text="Camada: {v2>/fifoScenario/layerText}" wrapping="true" class="sapUiTinyMarginTop"/>
              <HBox wrap="Wrap" class="sapUiSmallMarginTop"><ObjectStatus title="Ajuste MOD em estoque" text="R$ 0,00"/><ObjectStatus title="Ajuste GGF em estoque" text="{v2>/fifoScenario/stockAmount}"/><ObjectStatus title="Ajuste MOD consumido" text="R$ 0,00"/><ObjectStatus title="Ajuste GGF consumido" text="{v2>/fifoScenario/consumedAmount}"/><ObjectStatus title="Classificação do consumido" text="{v2>/fifoScenario/consumedStatusText}" state="Warning"/></HBox>
              <Text text="{v2>/fifoScenario/splitReason}" wrapping="true" class="sapUiTinyMarginTop"/>
            </VBox></content>
          </Panel>
          <Title text="6. Prévia Contábil" level="H2" titleStyle="H4" class="sapUiLargeMarginTop" />
          <MessageStrip text="Prévia técnica somente leitura. Não cria MaterialRevaluation nem Journal Entry. Os códigos de conta precisam de aprovação funcional e validação da determinação SAP." type="Warning" showIcon="true" />
          <Table items="{v2>/accountingPreview/summaries}" class="sapUiSmallMarginTop">
            <columns><Column><Text text="Tipo"/></Column><Column hAlign="End"><Text text="A absorver"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Destino estoque"/></Column><Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Destino CPV"/></Column><Column hAlign="End"><Text text="Bloqueado"/></Column><Column hAlign="End"><Text text="Diferença"/></Column></columns>
            <items><ColumnListItem><cells><Text text="{v2>category}"/><Text text="{v2>toAbsorb}"/><Text text="{v2>stock}"/><Text text="{v2>cpv}"/><Text text="{v2>blocked}"/><ObjectStatus text="{v2>difference}" state="{= ${v2>differenceCents} === '0' ? 'Success' : 'Error' }"/></cells></ColumnListItem></items>
          </Table>
          <HBox wrap="Wrap" justifyContent="SpaceBetween" class="sapUiSmallMarginTop"><ObjectStatus title="MOD a absorver" text="{v2>/accountingPreview/summaries/0/toAbsorb}"/><ObjectStatus title="GGF a absorver" text="{v2>/accountingPreview/summaries/1/toAbsorb}"/><ObjectStatus title="Total" text="{v2>/accountingPreview/totals/toAbsorb}"/><ObjectStatus title="Destino estoque" text="{v2>/accountingPreview/totals/stock}"/><ObjectStatus title="Destino CPV" text="{v2>/accountingPreview/totals/cpv}"/><ObjectStatus title="Bloqueado" text="{v2>/accountingPreview/totals/blocked}"/><ObjectStatus title="Diferença" text="{v2>/accountingPreview/totals/difference}"/></HBox>
          <HBox wrap="Wrap" class="sapUiTinyMarginTop"><ObjectStatus title="Débitos previstos" text="{v2>/accountingPreview/totals/debits}"/><ObjectStatus title="Créditos previstos" text="{v2>/accountingPreview/totals/credits}"/><ObjectStatus title="Diferença D/C" text="{v2>/accountingPreview/totals/accountingDifference}" state="{= ${v2>/accountingPreview/totals/accountingDifferenceCents} === '0' ? 'Success' : 'Error' }"/></HBox>
          <Table items="{v2>/accountingPreview/rows}" growing="true" growingScrollToLoad="true" class="sapUiTinyMarginTop">
            <columns><Column><Text text="OP / item / tipo"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Origem / critério"/></Column><Column hAlign="End"><Text text="Total / estoque / consumido"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Contas e dimensões"/></Column><Column><Text text="Status / bloqueios"/></Column></columns>
            <items><ColumnListItem><cells><ObjectIdentifier title="OP {v2>orderNumber} · {v2>item} · {v2>category}" text="{v2>quantity} {v2>unit}"/><Text text="{v2>accountOriginal} · {v2>criterion} · {v2>id}" wrapping="true"/><Text text="{v2>total} · {v2>stock} · {v2>consumed}"/><Text text="{v2>accountingOriginText} · {v2>dimensionsText}" wrapping="true"/><ObjectStatus text="{v2>statusText} · {v2>reasonsText}" state="Warning"/></cells></ColumnListItem></items>
          </Table>
          <Panel headerText="A. Estoque · MaterialRevaluation" expandable="true" expanded="false" class="sapUiTinyMarginTop">
            <content><VBox><MessageStrip text="Grupo de documento previsto; quantidade de documentos depende do agrupamento comprovado por item, depósito, método, conta e dimensão." type="Information" showIcon="true"/><Table items="{v2>/accountingPreview/documents/0/lines}"><columns><Column><Text text="OP / item / depósito"/></Column><Column><Text text="Conta estoque / contrapartida"/></Column><Column hAlign="End"><Text text="Valor"/></Column><Column><Text text="Origem / dimensões"/></Column></columns><items><ColumnListItem><cells><Text text="{v2>orderNumber} · {v2>item} · {v2>warehouse}"/><Text text="{v2>debitAccount} / {v2>creditAccount}"/><Text text="{v2>amount}"/><Text text="{v2>origin} · {v2>dimensions}"/></cells></ColumnListItem></items></Table><ObjectStatus title="Status" text="{v2>/accountingPreview/documents/0/statusText}"/><Text text="{v2>/accountingPreview/documents/0/reason}"/><Text text="Payload" textDirection="LTR"/><Text text="null"/></VBox></content>
          </Panel>
          <Panel headerText="B. CPV · Journal Entry" expandable="true" expanded="false" class="sapUiTinyMarginTop">
            <content><VBox><MessageStrip text="Somente operações explicitamente classificadas e com conta CPV/contrapartida completas podem gerar uma linha conceitual." type="Information" showIcon="true"/><Table items="{v2>/accountingPreview/documents/1/lines}"><columns><Column><Text text="OP / item / quantidade"/></Column><Column><Text text="CPV / transitória"/></Column><Column hAlign="End"><Text text="Valor"/></Column><Column><Text text="Origem / dimensões"/></Column></columns><items><ColumnListItem><cells><Text text="{v2>orderNumber} · {v2>item} · {v2>quantity} {v2>unit}"/><Text text="{v2>debitAccount} / {v2>creditAccount}"/><Text text="{v2>amount}"/><Text text="{v2>origin} · {v2>dimensions}"/></cells></ColumnListItem></items></Table><ObjectStatus title="Status" text="{v2>/accountingPreview/documents/1/statusText}"/><Text text="{v2>/accountingPreview/documents/1/reason}"/><Text text="Payload" textDirection="LTR"/><Text text="null"/></VBox></content>
          </Panel>
          <Panel headerText="C. Fechamento · transitórias MOD/GGF" expandable="true" expanded="false" class="sapUiTinyMarginTop">
            <content><VBox><MessageStrip text="A linha de fechamento só cobre parcelas aptas; o saldo bloqueado não é liquidado nem apagado." type="Information" showIcon="true"/><Table items="{v2>/accountingPreview/documents/2/lines}"><columns><Column><Text text="Tipo"/></Column><Column><Text text="Conta transitória / fechamento"/></Column><Column hAlign="End"><Text text="Valor"/></Column></columns><items><ColumnListItem><cells><Text text="{v2>category}"/><Text text="{v2>debitAccount} / {v2>creditAccount}"/><Text text="{v2>amount}"/></cells></ColumnListItem></items></Table><ObjectStatus title="Status" text="{v2>/accountingPreview/documents/2/statusText}"/><Text text="{v2>/accountingPreview/documents/2/reason}"/><Text text="Payload" textDirection="LTR"/><Text text="null"/></VBox></content>
          </Panel>
          <Panel headerText="Demonstração técnica independente · não integra o período" expandable="true" expanded="false" visible="{= !!${v2>/technicalAccountingPreview} }" class="sapUiTinyMarginTop">
            <content><VBox><MessageStrip text="OP 83 e R$ 100,00 são apenas cenário de estrutura. Não são conta, rateio ou resultado funcional do fechamento." type="Warning" showIcon="true"/><HBox wrap="Wrap"><ObjectStatus title="A absorver" text="{v2>/technicalAccountingPreview/totals/toAbsorb}"/><ObjectStatus title="Estoque" text="{v2>/technicalAccountingPreview/totals/stock}"/><ObjectStatus title="CPV" text="{v2>/technicalAccountingPreview/totals/cpv}"/><ObjectStatus title="Bloqueado" text="{v2>/technicalAccountingPreview/totals/blocked}"/></HBox><List items="{v2>/technicalAccountingPreview/rows}"><StandardListItem title="OP {v2>orderNumber} · {v2>item} · {v2>category}" description="{v2>statusText} · {v2>reasonsText}"/></List><List items="{v2>/technicalAccountingPreview/documents}"><StandardListItem title="{v2>documentType} · {v2>statusText}" description="{v2>reason}"/></List></VBox></content>
          </Panel>
          <Title text="{ggfText>ggfV2Entries}" level="H2" titleStyle="H4" class="sapUiMediumMarginTop" />
          <Table items="{v2>/entries}" growing="true" growingScrollToLoad="true">
            <columns><Column><Text text="Conta"/></Column><Column><Text text="TransId / doc"/></Column><Column><Text text="Data"/></Column><Column hAlign="End"><Text text="Débito"/></Column><Column hAlign="End"><Text text="Crédito"/></Column><Column><Text text="Filial / dimensões"/></Column></columns>
            <items><ColumnListItem><cells><ObjectIdentifier title="{v2>account}" text="{v2>accountName}"/><Text text="{v2>transId} / {v2>document}"/><Text text="{v2>date}"/><Text text="{v2>debit}"/><Text text="{v2>credit}"/><Text text="{v2>branch} / {v2>dimensionsText}"/></cells></ColumnListItem></items>
          </Table>
          <Title text="{ggfText>ggfV2ResourceLines}" level="H2" titleStyle="H4" class="sapUiMediumMarginTop" />
          <Table items="{v2>/resources}" growing="true" growingScrollToLoad="true">
            <columns><Column><Text text="Recurso / OP"/></Column><Column><Text text="Componente"/></Column><Column hAlign="End"><Text text="Quantidade"/></Column><Column><Text text="Unidade"/></Column><Column hAlign="End"><Text text="Custo unitário"/></Column><Column hAlign="End"><Text text="Padrão"/></Column><Column hAlign="End"><Text text="LineTotal do mov. SAP (referência)"/></Column><Column><Text text="Documento / data"/></Column></columns>
            <items><ColumnListItem><cells><ObjectIdentifier title="{v2>resource} / OP {v2>order}" text="{v2>producedItem} · {v2>itemDescription} · {v2>category}"/><Text text="Cost{v2>component}"/><Text text="{v2>quantity}"/><Text text="{v2>unit}"/><Text text="{v2>unitCost}"/><Text text="{v2>amount}"/><Text text="{v2>movementValue}"/><Text text="{v2>document} / {v2>date}"/></cells></ColumnListItem></items>
          </Table>
          <Title text="Cadastro atual dos recursos (tarifas sem histórico mensal)" level="H2" titleStyle="H4" class="sapUiMediumMarginTop" />
          <Table items="{v2>/resourceCatalog}" growing="true" growingScrollToLoad="true">
            <columns><Column><Text text="Recurso"/></Column><Column><Text text="Tipo"/></Column><Column><Text text="Unidade"/></Column><Column><Text text="Componentes CostN atuais"/></Column></columns>
            <items><ColumnListItem><cells><ObjectIdentifier title="{v2>resource}" text="{v2>description}"/><Text text="{v2>type}"/><Text text="{v2>unit}"/><Text text="{v2>componentsText}"/></cells></ColumnListItem></items>
          </Table>
          <Title text="Fontes e completude" level="H2" titleStyle="H4" class="sapUiMediumMarginTop" />
          <List items="{v2>/completeness}"><StandardListItem title="{v2>source}" description="Recebidas: {v2>received} · Controle SAP: {v2>expected} · {v2>control}"/></List>
          <Text text="{v2>/evidence}" wrapping="true" class="sapUiSmallMarginTop" />
          <List items="{v2>/blockers}"><StandardListItem title="{v2>text}" icon="sap-icon://message-warning"/></List>
        </VBox>
      </VBox>
    </content>
  </Page>
</mvc:View>
