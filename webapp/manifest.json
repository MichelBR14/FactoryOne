{
  "_version": "1.60.0",
  "sap.app": {
    "id": "factoreone.app",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        "",
        "en"
      ],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "0.1.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "sourceTemplate": {
      "id": "@sap/ux-app-migrator:freestyle",
      "version": "1.33.0",
      "toolsId": "8c75c502-37e8-49c0-9b37-37d057fdfbc9"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "factoreone.app.view.App",
      "type": "XML",
      "async": true,
      "id": "App"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "resources": {
      "css": [
        {
          "uri": "modules/ggf/css/closing.css"
        },
        {
          "uri": "css/navigation.css"
        }
      ]
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "factoreone.app.i18n.i18n",
          "supportedLocales": [
            "",
            "en"
          ],
          "fallbackLocale": ""
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "type": "View",
        "viewType": "XML",
        "async": true,
        "path": "factoreone.app.view",
        "controlId": "app",
        "controlAggregation": "pages"
      },
      "routes": [
        {
          "name": "ggfV2Absorption",
          "pattern": "ggf/v2/apuracao",
          "target": [
            "ggfV2Absorption"
          ]
        },
        {
          "name": "ggfRevaluation",
          "pattern": "ggf/reavaliacao",
          "target": [
            "ggfRevaluation"
          ]
        },
        {
          "name": "ggfClosing",
          "pattern": "ggf/fechamento",
          "target": [
            "ggfFunction"
          ]
        },
        {
          "name": "ggfClassifications",
          "pattern": "ggf/classificacao",
          "target": [
            "ggfFunction"
          ]
        },
        {
          "name": "ggfAllocations",
          "pattern": "ggf/rateios",
          "target": [
            "ggfFunction"
          ]
        },
        {
          "name": "ggf",
          "pattern": "ggf",
          "target": [
            "ggf"
          ]
        },
        {
          "name": "main",
          "pattern": "",
          "target": [
            "main"
          ]
        }
      ],
      "targets": {
        "ggfV2Absorption": {
          "id": "ggfV2Absorption",
          "name": "AbsorptionV2",
          "path": "factoreone.app.modules.ggf.view"
        },
        "ggfRevaluation": {
          "id": "ggfRevaluation",
          "name": "Revaluation",
          "path": "factoreone.app.modules.ggf.view"
        },
        "ggf": {
          "id": "ggf",
          "name": "Menu",
          "path": "factoreone.app.modules.ggf.view"
        },
        "ggfFunction": {
          "id": "ggfFunction",
          "name": "Closing",
          "path": "factoreone.app.modules.ggf.view"
        },
        "main": {
          "id": "main",
          "name": "Home"
        }
      }
    }
  }
}
