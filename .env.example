# Configuração de integração por cliente. Copie para .env (fora do git) e preencha.
# Em produção no Web Client a sessão vem por SSO: USER/PASSWORD ficam vazios.

# dev | test | prod. Escrita (POST/PATCH) no Service Layer só é permitida em dev/test.
FBO_ENV=dev

FBO_SL_URL=https://servidor:50000
FBO_SL_COMPANY_DB=
FBO_SL_USER=
FBO_SL_PASSWORD=
FBO_SL_VERIFY_TLS=true
