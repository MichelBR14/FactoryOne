{
  "name": "factoreone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "ui5 serve --port 8080",
    "ggf:sap:discover": "node scripts/ggf-sap-discover.mjs && node scripts/ggf-sap-survey.mjs",
    "ggf:sap:read": "node scripts/ggf-sap-read.mjs",
    "ggf:sap:orders": "node scripts/ggf-sap-order-audit.mjs",
    "ggf:sap:functional": "node scripts/ggf-sap-functional-diagnostic.mjs",
    "ggf:sap:calculate": "node scripts/ggf-sap-calculate.mjs",
    "ggf:sap:validate": "node scripts/ggf-real-validation.mjs",
    "ggf:sap:preview": "node scripts/ggf-sap-preview.mjs",
    "test:browser": "playwright test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf --glob resources mta_archives *.module",
    "build:module": "ui5 build --dest factoreone.module --clean-dest && node scripts/generate-webclient-extension.mjs",
    "compress": "node scripts/compress.mjs",
    "build": "mbt build"
  },
  "devDependencies": {
    "@openui5/types": "~1.120.50",
    "@playwright/test": "^1.63.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@ui5/cli": "^4.0.70",
    "archiver": "^7.0.1",
    "esbuild": "0.21.5",
    "js-yaml": "^4.1.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.6.0",
    "ui5-tooling-transpile": "^3.13.1",
    "vitest": "^2.1.0"
  }
}
